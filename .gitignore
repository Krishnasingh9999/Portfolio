# --- .gitignore for React, Vite & TypeScript Portfolios ---

# Dependencies
# Never check in node_modules, as package managers (npm/yarn/pnpm) reconstruct it from package.json
node_modules/
jspm_packages/
.pnp
.pnp.js

# Build Outputs
# Compiled build assets should not be stored in source control (keeps git history light)
dist/
dist-ssr/
build/
out/
bin/
obj/
coverage/
.shadow-cljs

# Environment Variables & Secrets
# Prevents accidental leakage of private API keys, database credentials, or secret tokens (highly recruiter-friendly)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
credentials.json

# IDEs & Text Editors Configuration
# Ignore user-specific editor workspace setups
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo
*.swp
.project
.classpath
.settings/
.factorypath
*.sublime-project
*.sublime-workspace

# System Files & Cache
# Ignore operating system-specific junk files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
ehthumbs.db

# Logs & Debugging
# Avoid committing execution logs to clean up code reviews
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Tools, Caches & Linters
# Ignore temporary caches generated by bundlers or type checkers
.vite/
.parcel-cache/
.eslintcache
*.tsbuildinfo
.next/
.nuxt/
.vercel
.turbo/
.cache/

